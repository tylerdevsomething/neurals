# The hosted brain: llama.cpp (pinned) + the probe, and the brain server.
#
#   docker build -f Dockerfile.brain -t neurals-brain .
#   docker run -p 8080:8080 -v neurals-model:/data -e PAYER_KEY='[...]' -e INDEXER_URL=https://<indexer>/api neurals-brain
#
# The model (~1.1 GB) is fetched into /data on first start and checked against its SHA-256.
# Fixed CPU features (AVX2, FMA, F16C) so every host takes the same kernels: receipts depend on it.

FROM debian:bookworm-slim AS build
RUN apt-get update && apt-get install -y --no-install-recommends git g++ cmake make ca-certificates && rm -rf /var/lib/apt/lists/*
WORKDIR /src
COPY probe ./probe
RUN git clone -q --depth 1 --branch b12033 https://github.com/ggml-org/llama.cpp llama.cpp \
 && cmake -S probe -B build -DLLAMA_DIR=/src/llama.cpp -DCMAKE_BUILD_TYPE=Release \
      -DGGML_NATIVE=OFF -DGGML_AVX=ON -DGGML_AVX2=ON -DGGML_FMA=ON -DGGML_F16C=ON -DGGML_OPENMP=OFF \
 && cmake --build build -j 4 --target neurals-probe neurals-traits

FROM node:24-slim
RUN apt-get update && apt-get install -y --no-install-recommends curl ca-certificates && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --omit=dev --no-audit --no-fund
COPY brain ./brain
COPY brainserver ./brainserver
COPY deploy ./deploy
COPY site/public/wasm ./site/public/wasm
COPY --from=build /src/build/neurals-probe /src/build/neurals-traits ./bin/
ENV NODE_ENV=production BRAIN_CONFIG=deploy/brain.devnet.json \
    MODEL_URL=https://huggingface.co/Qwen/Qwen2.5-1.5B-Instruct-GGUF/resolve/main/qwen2.5-1.5b-instruct-q4_k_m.gguf \
    MODEL_SHA256=6a1a2eb6d15622bf3c96857206351ba97e1af16c30d7a74ee38970e434e9407e
EXPOSE 8080
CMD ["sh", "-c", "M=/data/qwen2.5-1.5b-instruct-q4_k_m.gguf; [ -f $M ] || { curl -fL --retry 3 -o $M.part $MODEL_URL && mv $M.part $M; }; echo \"$MODEL_SHA256  $M\" | sha256sum -c - && exec node brainserver/server.ts \"$BRAIN_CONFIG\""]
